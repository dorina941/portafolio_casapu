}

.gallery-item:hover .gallery-overlay {
    transform: translateY(0);
}

.gallery-overlay h3 {
    font-size: 1.3rem;
    margin-bottom: 0.5rem;
}

.gallery-overlay p {
    font-size: 0.9rem;
    opacity: 0.9;
}

/* Contact Section */
.contact-section {
    padding: 100px 0;
    background: linear-gradient(135deg, 
        var(--purple-deep) 0%, 
        var(--blue-vibrant) 50%, 
        var(--lavender) 100%);
    color: white;
    position: relative;
    overflow: hidden;
}

.contact-section::before {
    content: '';
