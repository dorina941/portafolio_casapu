    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, 
        var(--pink-soft), 
        var(--blue-vibrant), 
        var(--blue-sky), 
        var(--lavender), 
        var(--purple-deep), 
        var(--yellow-bright));
}

/* Animations */
