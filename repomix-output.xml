    <style>
        /* Textura grain */
        .grain-texture {
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.05'/%3E%3C/svg%3E");
        }
        
        /* Animaciones personalizadas */
        @keyframes float {
            0%, 100% { transform: translateY(0px) translateX(0px); }
            33% { transform: translateY(-15px) translateX(10px); }
            66% { transform: translateY(10px) translateX(-10px); }
        }
        
        @keyframes pulse {
            0%, 100% { transform: scale(1); opacity: 0.8; }
            50% { transform: scale(1.05); opacity: 1; }
        }
        
        .animate-float {
            animation: float 8s ease-in-out infinite;
        }
        
        .animate-pulse-slow {
            animation: pulse 4s ease-in-out infinite;
        }
        
        .paint-blob {
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        
        /* Efecto de textura de pintura espesa */
        .paint-texture {
            background-image: 
                radial-gradient(circle at 20% 30%, rgba(255, 255, 255, 0.3) 0%, transparent 50%),
                radial-gradient(circle at 80% 70%, rgba(0, 0, 0, 0.1) 0%, transparent 50%);
            position: relative;
        }
        
        .paint-texture::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: 
                repeating-linear-gradient(45deg, transparent, transparent 2px, rgba(0, 0, 0, 0.03) 2px, rgba(0, 0, 0, 0.03) 4px);
            border-radius: inherit;
        }
        
        /* Efecto de pinceladas */
        .brush-stroke {
            position: absolute;
            background: inherit;
            opacity: 0.6;
            filter: blur(1px);
        }
        
        /* Mezcla de colores en bordes */
        .paint-mix {
            position: relative;
        }
        
        .paint-mix::after {
            content: '';
            position: absolute;
            inset: -2px;
            background: inherit;
            filter: blur(8px);
            opacity: 0.4;
            z-index: -1;
        }

        /* Glow que respira para botones */
        @keyframes breathe {
            0%, 100% { 
                box-shadow: 0 0 4px rgba(56, 189, 248, 0.15),
                            0 0 8px rgba(56, 189, 248, 0.08);
            }
            50% { 
                box-shadow: 0 0 6px rgba(56, 189, 248, 0.2),
                            0 0 12px rgba(56, 189, 248, 0.1);
            }
        }
        
        .glow-breathe {
            animation: breathe 3s ease-in-out infinite;
            transition: all 0.3s ease;
        }
        
        .glow-breathe:hover {
            box-shadow: 0 0 8px rgba(56, 189, 248, 0.35),
                        0 0 16px rgba(56, 189, 248, 0.2);
            transform: scale(1.02);
            background: rgba(15, 23, 42, 0.9);
        }

        /* Fondo tipo Matrix para la home */
        #matrix {
            position: fixed;
            inset: 0;
            z-index: 0;
            background: #0f172a;
        }

        .matrix-overlay {
            position: fixed;
            inset: 0;
            z-index: 1;
            pointer-events: none;
            /* Más luz arriba y degradado suave hacia abajo */
            background:
                linear-gradient(
