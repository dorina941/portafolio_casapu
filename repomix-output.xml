    height: 100%;
    pointer-events: none;
}

.particles circle {
    animation: particlePulse 2s ease-in-out infinite;
}

.particles circle:nth-child(odd) {
    animation-delay: 0s;
}

.particles circle:nth-child(even) {
    animation-delay: 1s;
}

@keyframes particlePulse {
    0%, 100% {
        opacity: 0.7;
        transform: scale(1);
    }
    50% {
        opacity: 1;
        transform: scale(1.2);
    }
}

.circuit-lines path {
    animation: circuitFlow 4s ease-in-out infinite;
}

.circuit-lines path:nth-child(odd) {
    animation-delay: 0s;
}

.circuit-lines path:nth-child(even) {
    animation-delay: 2s;
}

@keyframes circuitFlow {
    0%, 100% {
        opacity: 0.3;
    }
    50% {
        opacity: 0.6;
    }
}
